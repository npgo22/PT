	(text "Normal range:\n0 mA open/fault-low  -> 0.000 V\n4 mA                 -> 0.400 V = 0 psi\n20 mA                -> 2.000 V = 5000 psi\n21.5 mA overrange    -> 2.150 V\nPressure scale:\n16 mA span = 5000 psi\n3.2 uA/psi\n100 ohm * 3.2 uA/psi = 320 uV/psi\n0.1 psi = 32 uV\n\nWith internal VREF = 2.442 V, gain 1"
		(exclude_from_sim no)
		(at 217.17 66.04 0)
